APP_NAME=AI Animation Studio API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend
FORCE_HTTPS=false
RATE_LIMIT_ENABLED=false
APP_SECRET_KEY=development-only-secret-change-me
POSTGRES_DB=ai_animation_studio
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://app_user:change-me@postgres:5432/ai_animation_studio
REDIS_URL=redis://redis:6379/0
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
